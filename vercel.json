{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/pipeline/news-ingest?tiers=1,2",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/pipeline/news-ingest?tiers=3,4,5",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/pipeline/news-ingest?tiers=6",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/pipeline/news-enrich",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/pipeline/news-process",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/pipeline/newsletter-send?fire=1030utc",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/pipeline/newsletter-send?fire=1130utc",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/pipeline/story-text",
      "schedule": "35 * * * *"
    },
    {
      "path": "/api/pipeline/story-summaries",
      "schedule": "45 * * * *"
    },
    {
      "path": "/api/pipeline/outreach-monitor",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/pipeline/sponsor-followup",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/pipeline/edition-engagement",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/pipeline/weekly-scorecard",
      "schedule": "30 12 * * 1"
    }
  ]
}
